# Runtime environment only. Never commit real secrets.
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-random-32-character-secret
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_video_director
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/ai_video_director
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
MEDIA_STORAGE_ROOT=./media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Trained model provider contract. Keep the endpoint, key and exact model id
# in the deployment secret manager or local .env, never in source code.
LLM_ENABLED=false
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_API_KEY=replace-me
LLM_MODEL=your-trained-model-id
LLM_TIMEOUT_SECONDS=60
ALLOW_MOCK_AI=false

# Production must have a worker and queue; local development may use the
# explicit synchronous fallback.
CELERY_ENABLED=false
RENDER_SYNC_FALLBACK=true
